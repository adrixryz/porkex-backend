# Copy this file to .env and fill in your own values.

# Database URL.
#   Local development: a SQLite file. The path is resolved against the folder
#   you run the command from, so this must include the prisma/ prefix.
#   Production (Turso): the libsql:// URL from the Turso dashboard.
# The app reaches it through the libSQL driver adapter, so no other change is
# needed when you switch between the two. Use db:apply for an empty database.
# For existing data, use db:migrate with a verified backup; see README.md.
# Maintenance scripts resolve relative file paths against the backend root.
DATABASE_URL="file:./prisma/dev.db"

# Only for a hosted libSQL/Turso database. Leave it unset (or empty) for the
# local file above; the adapter then connects without a token.
TURSO_AUTH_TOKEN=""

# API port
PORT=3000

# Which frontend origins may call this API, comma separated, e.g.
#   CORS_ORIGINS="https://porkex-web.onrender.com"
# Leave it unset in development: the Vite dev server proxies /api and /auth, so
# the browser sees a single origin and CORS never applies. Set it when the
# frontend is deployed as its own service.
CORS_ORIGINS=""

# Secret used to sign the JWT tokens. Generate a long random string,
# e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-with-a-long-random-string"

# Registration is enabled by default. Set false to hide Sign Up and close it.
ALLOW_REGISTRATION="true"

# Rate limits, optional. Auth counts only FAILED attempts per 15 minutes and
# per IP (a normal login never consumes the budget); the rest of the API is a
# flat per-minute budget per IP. Both answer 429 with a JSON error.
# AUTH_RATE_LIMIT_MAX=30
# API_RATE_LIMIT_MAX=600
