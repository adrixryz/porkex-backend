{
  "name": "backend",
  "version": "1.1.1",
  "main": "src/index.ts",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register/transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,mjs,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,js,json}\"",
    "test": "node tests/run.mjs",
    "db:push": "node scripts/apply-schema.js",
    "db:apply": "node scripts/apply-schema.js",
    "db:migrate": "node scripts/migrate-db.js",
    "db:check": "node scripts/apply-schema.js --check",
    "db:seed": "node scripts/seed.js",
    "db:reset": "prisma generate && node scripts/seed.js --fresh",
    "db:studio": "prisma studio",
    "db:backup": "node scripts/backup-db.js",
    "db:verify-backup": "node scripts/verify-backup.js",
    "check:currencies": "node scripts/check-currencies.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
