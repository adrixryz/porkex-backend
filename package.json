{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register/transpile-only src/index.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,mjs,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,js,json}\"",
    "test": "node tests/run.mjs",
    "db:push": "prisma db push",
    "db:apply": "node scripts/apply-schema.js",
    "db:check": "node scripts/apply-schema.js --check",
    "db:seed": "node scripts/seed.js",
    "db:studio": "prisma studio",
    "db:backup": "node scripts/backup-db.js",
    "db:verify-backup": "node scripts/verify-backup.js",
    "check:currencies": "node scripts/check-currencies.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.24",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
